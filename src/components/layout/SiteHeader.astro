---
import { Icon } from 'astro-icon/components';
import { SITE } from '@/config/site';
import { SORTED_CATEGORIES } from '@/config/categories';
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import MobileNavSheet from './MobileNavSheet.astro';
import { i18n, stripLang } from '@/config/i18n';

/**
 * 상단 고정 내비게이션 바.
 * CRITICAL: 항목은 categories.ts를 order 오름차순으로 순회해 만든다. 하드코딩하지 않는다.
 * CRITICAL: 링크는 전부 `href()`를 거친다 — 영어 화면에서 한국어 페이지로 새지 않게 한다.
 *
 * 활성 판정은 **언어 접두사를 뗀** 경로로 한다. `/en/archive`도 `/archive`와 같은 항목이다.
 */
const { t, href } = i18n(Astro.url);
const pathname = stripLang(Astro.url.pathname);

interface NavItem {
  href: string;
  label: string;
  /** 현재 경로가 이 항목에 속하는지 */
  active: boolean;
}

// site.navOrder는 카테고리 id와 예약어 'archive'로 이루어진다.
const navItems: NavItem[] = [
  { href: href('/'), label: t.nav.home, active: pathname === '/' },
  ...SITE.navOrder.map((key): NavItem => {
    if (key === 'archive') {
      return {
        href: href('/archive'),
        label: t.nav.archive,
        active: pathname.startsWith('/archive'),
      };
    }
    const category = SORTED_CATEGORIES.find((c) => c.id === key);
    if (!category) {
      throw new Error(
        `[site.ts] navOrder에 알 수 없는 값이 있습니다: "${key}". categories.ts의 id 또는 'archive'만 허용됩니다.`,
      );
    }
    return {
      href: href(`/${category.id}`),
      label: category.label,
      active: pathname === `/${category.id}` || pathname.startsWith(`/${category.id}/`),
    };
  }),
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={href('/')}>{SITE.title}</a>

    <nav class="nav-desktop" aria-label={t.nav.primaryLabel}>
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <NavLink href={item.href} active={item.active}>
                {item.label}
              </NavLink>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="icon-button" href={href('/search')} aria-label={t.nav.searchLabel}>
        <Icon name="lucide:search" aria-hidden="true" />
      </a>
      <LangToggle />
      <ThemeToggle />
      <button
        type="button"
        class="icon-button nav-toggle"
        id="mobile-nav-trigger"
        aria-label={t.nav.openMenu}
        aria-expanded="false"
        aria-controls="mobile-nav-sheet"
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
        hidden
      >
        <Icon name="lucide:menu" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<MobileNavSheet items={navItems} />

<script>
  // CRITICAL: JS가 실행되지 않으면 햄버거 버튼을 노출하지 않는다.
  // 대신 폴백 내비(details 요소)가 보이며, 어떤 경우에도 카테고리로 이동할 수 있다.
  document.getElementById('mobile-nav-trigger')?.removeAttribute('hidden');
  document.getElementById('mobile-nav-fallback')?.setAttribute('hidden', '');
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height); /* 56px [local extension] */
    background: var(--nav-glass); /* [local extension] 반투명 기능 레이어 */
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-ext-4);
    height: 100%;
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-body); /* 17px */
    line-height: var(--text-body--line-height);
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-desktop {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--spacing-ext-5); /* 20px */
    list-style: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-ext-1);
    flex-shrink: 0;
  }

  /* 375px에서 액션이 4개(검색·언어·테마·메뉴)까지 늘어난다.
     간격을 0으로 줄여도 각 버튼의 44px 히트 영역은 그대로 유지된다. */
  @media (max-width: 400px) {
    .header-actions {
      gap: 0;
    }
  }

  /* .icon-button 규격은 global.css에 있다 (여러 컴포넌트가 공유한다) */
  .nav-toggle {
    display: none;
  }

  /* 768px 미만: 중앙 내비를 숨기고 햄버거를 노출한다 */
  @media (max-width: 767px) {
    .nav-desktop {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }
  }
</style>
