---
import type { MarkdownHeading } from 'astro';
import { i18n } from '@/config/i18n';

/**
 * 목차.
 * 1024px 이상은 우측 sticky 컬럼, 미만은 본문 상단의 접힘 블록으로 나타난다.
 * depth 2·3만 쓴다 — h1은 글 제목이고, h4 이하는 목차에 넣지 않는다.
 */
interface Props {
  headings: MarkdownHeading[];
  /** desktop: 우측 sticky 컬럼 / mobile: 본문 상단 접힘 블록 */
  variant: 'desktop' | 'mobile';
}

const { headings, variant } = Astro.props;
const { t } = i18n(Astro.url);
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 2 &&
    (variant === 'desktop' ? (
      <nav class="toc toc-desktop" aria-label={t.post.tocTitle}>
        <p class="eyebrow">{t.post.tocTitle}</p>
        <ul class="toc-list">
          {items.map((item) => (
            <li class:list={['toc-item', `depth-${item.depth}`]}>
              <a class="toc-link clamp-2" href={`#${item.slug}`} data-toc-link={item.slug}>
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <details class="toc toc-collapsible">
        <summary class="toc-summary">{t.post.tocTitle}</summary>
        <ul class="toc-list">
          {items.map((item) => (
            <li class:list={['toc-item', `depth-${item.depth}`]}>
              <a class="toc-link" href={`#${item.slug}`}>
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
}

<script>
  // 현재 섹션 하이라이트. IntersectionObserver 하나로 처리한다.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const byId = new Map<string, HTMLAnchorElement>();
    for (const link of links) byId.set(link.dataset.tocLink!, link);

    const targets = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let activeId: string | null = null;
    const setActive = (id: string): void => {
      if (id === activeId) return;
      if (activeId) byId.get(activeId)?.classList.remove('active');
      byId.get(id)?.classList.add('active');
      activeId = id;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '-25% 0px -70% 0px' },
    );

    for (const target of targets) observer.observe(target);
  }
</script>

<style>
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-ext-2); /* 8px */
    margin-top: var(--spacing-ext-3);
  }

  .toc-item.depth-3 {
    padding-left: var(--spacing-ext-3); /* 12px */
  }

  .toc-link {
    position: relative;
    display: block;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    letter-spacing: var(--text-small--letter-spacing);
    color: var(--fg-muted);
    text-decoration: none;
    padding-left: var(--spacing-ext-3);
    transition: color var(--duration-micro) var(--ease-standard);
  }

  .toc-link:hover {
    color: var(--fg);
  }

  .toc-link.active {
    color: var(--fg);
  }

  /* 현재 섹션 표시 — 좌측 2px 바 (색상만으로 표시하지 않는다) */
  .toc-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    border-radius: var(--radius-pill);
  }

  /* ---------- 데스크톱 sticky 컬럼 ---------- */
  @media (min-width: 1024px) {
    .toc-desktop {
      position: sticky;
      top: var(--scroll-offset); /* 헤더 56px + 여백 32px */
      align-self: start;
      max-height: calc(100vh - var(--scroll-offset) - var(--spacing-ext-8));
      overflow-y: auto;
    }
  }

  /* ---------- 모바일·태블릿 접힘 블록 ---------- */
  .toc-collapsible {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    padding: var(--spacing-content);
    margin-bottom: var(--spacing-ext-7);
  }

  .toc-summary {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    font-weight: 600;
    letter-spacing: 0.4px;
    color: var(--fg-muted);
    cursor: pointer;
    min-height: 24px;
    display: flex;
    align-items: center;
  }
</style>
