---
import { Icon } from 'astro-icon/components';
import { i18n, LANG_META, type Lang } from '@/config/i18n';

/**
 * 번역본이 없어 원문을 그대로 보여 주고 있을 때의 안내.
 *
 * 왜 글을 감추지 않고 원문을 내보내는가: 번역이 없다고 목록에서 빼면 영어 사이트가
 * 텅 비어 보인다. 읽을 수 있는 사람에겐 원문이 있는 편이 낫고, 못 읽는 사람에겐
 * 무엇이 있는지라도 보이는 편이 낫다.
 *
 * CRITICAL: 이 배너는 `data-pagefind-body` 밖에 있어야 한다. 안에 들어가면 모든
 * 폴백 글의 검색 발췌가 이 문구로 시작한다.
 *
 * CRITICAL: 성공/경고를 뜻하는 색을 쓰지 않는다(토큰에 없다). 안내는 accent tint와
 * 아이콘으로만 구분한다.
 */
interface Props {
  /** 본문이 실제로 쓰인 언어 */
  contentLang: Lang;
}

const { contentLang } = Astro.props;
const { lang, t } = i18n(Astro.url);
const contentMeta = LANG_META[contentLang];
---

<aside class="notice" lang={LANG_META[lang].htmlLang}>
  <Icon name="lucide:languages" class="notice-icon" aria-hidden="true" />
  <p class="notice-text">{t.post.fallbackNotice(LANG_META[lang].nativeName)}</p>
  <span class="notice-lang meta-text" lang={contentMeta.htmlLang}>{contentMeta.nativeName}</span>
</aside>

<style>
  .notice {
    display: flex;
    align-items: center;
    gap: var(--spacing-ext-3);
    padding: var(--spacing-content); /* 20px */
    margin-bottom: var(--spacing-ext-7); /* 32px */
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--accent-tint);
  }

  .notice-icon {
    width: 20px;
    height: 20px;
    stroke-width: 1.5;
    color: var(--accent);
    flex-shrink: 0;
  }

  .notice-text {
    flex: 1;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    letter-spacing: var(--text-small--letter-spacing);
    color: var(--fg-secondary);
    margin: 0;
  }

  .notice-lang {
    flex-shrink: 0;
  }

  @media (max-width: 479px) {
    .notice {
      flex-wrap: wrap;
      row-gap: var(--spacing-ext-2);
    }

    .notice-text {
      flex-basis: calc(100% - 20px - var(--spacing-ext-3));
    }
  }
</style>
