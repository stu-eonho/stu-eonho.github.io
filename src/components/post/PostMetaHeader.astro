---
import { Image } from 'astro:assets';
import Badge from '@/components/ui/Badge.astro';
import TagChip from '@/components/tag/TagChip.astro';
import { getCategory } from '@/config/categories';
import { formatLong, toISODate } from '@/lib/date';
import { slugifyTag } from '@/lib/tags';
import type { Post } from '@/lib/posts';
import { i18n } from '@/config/i18n';

interface Props {
  post: Post;
  readingTime: number;
}

const { post, readingTime } = Astro.props;
const { lang, t, href } = i18n(Astro.url);
const category = getCategory(post.data.category);
---

<header class="post-header" data-reveal-onload>
  <a class="category-link" href={href(`/${category.id}`)}>
    <Badge tone="accent">{category.label}</Badge>
  </a>

  <h1 class="post-title">{post.data.title}</h1>

  {post.data.description && <p class="post-desc">{post.data.description}</p>}

  <p class="meta-text post-dates">
    <time datetime={toISODate(post.data.date)}>{formatLong(post.data.date, lang)}</time>
    {
      post.data.updated && (
        <>
          {` · ${t.post.updated} `}
          <time datetime={toISODate(post.data.updated)}>{formatLong(post.data.updated, lang)}</time>
        </>
      )
    }
    {` · ${t.post.readingTime(readingTime)}`}
  </p>

  {
    post.data.tags.length > 0 && (
      <ul class="tag-list">
        {post.data.tags.map((tag) => (
          <li>
            <TagChip slug={slugifyTag(tag)} label={tag} />
          </li>
        ))}
      </ul>
    )
  }

  {
    post.data.cover && post.data.coverAlt && (
      <div class="cover">
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt}
          widths={[720, 1440]}
          sizes="(min-width: 768px) 720px, 100vw"
          loading="lazy"
        />
      </div>
    )
  }
</header>

<style>
  .post-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-ext-3);
  }

  .category-link {
    text-decoration: none;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: var(--text-section-mobile); /* 768px 미만 28px / 32px */
    line-height: var(--text-section-mobile--line-height);
    font-weight: 600;
    color: var(--fg);
  }

  @media (min-width: 768px) {
    .post-title {
      font-size: var(--text-section); /* 40px / 44px */
      line-height: var(--text-section--line-height);
    }
  }

  .post-desc {
    font-size: var(--text-card);
    line-height: var(--text-card--line-height);
    color: var(--fg-secondary);
  }

  @media (min-width: 768px) {
    .post-desc {
      font-size: var(--text-tile);
      line-height: var(--text-tile--line-height);
      letter-spacing: var(--text-tile--letter-spacing);
      font-weight: 400;
    }
  }

  .post-dates {
    margin: 0;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-ext-2);
    list-style: none;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-top: var(--spacing-ext-7); /* 32px */
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
