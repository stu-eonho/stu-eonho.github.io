---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import EducationList from './EducationList.astro';
import CareerList from './CareerList.astro';
import SkillGroups from './SkillGroups.astro';
import InterestList from './InterestList.astro';
import { PROFILE, PROFILE_PHOTO, isPlaceholder, type SocialType } from '@/config/profile';
import { i18n, text } from '@/config/i18n';

/**
 * 홈의 프로필 카드 — CV 한 장처럼 읽히는 단일 덩어리.
 *
 * 신원(사진·이름·소개·연락처·링크) → 소개문 → 학적 → 경력 → 스킬 → 관심 분야가
 * 하나의 Card 안에서 hairline으로만 나뉜다. 섹션을 페이지 전체에 흩뿌리지 않는다.
 *
 * CRITICAL: 프로필 사진은 LCP 요소다 — eager + fetchpriority=high로 두고 리빌을 걸지 않는다.
 * CRITICAL: 값을 지운 항목은 요소 자체가 사라진다. 빈 상자나 어긋난 여백을 남기지 않는다.
 *   단, 꺾쇠 플레이스홀더(`<...>`)는 그대로 보여 준다 — 무엇을 채워야 하는지
 *   화면에서 바로 보이는 편이 낫고, 지우면 그때 사라진다.
 */
const SOCIAL_ICON: Record<SocialType, string> = {
  github: 'lucide:github',
  scholar: 'lucide:graduation-cap',
  linkedin: 'lucide:linkedin',
  x: 'lucide:at-sign',
  email: 'lucide:mail',
  orcid: 'lucide:badge-check',
  homepage: 'lucide:globe',
};

const { lang, t } = i18n(Astro.url);

const name = text(PROFILE.name, lang);
const initial = isPlaceholder(name) ? '?' : name.trim().charAt(0);

// 소속 한 줄은 education[0]에서 파생된다. education이 비면 이 줄도 사라진다.
const top = PROFILE.education[0];
const affiliation = top
  ? [
      text(top.school, lang),
      text(top.department, lang),
      t.profile.degreeShort[top.degree],
      top.endDate === null ? t.profile.enrolled : t.profile.graduated,
    ].join(' ')
  : undefined;

// 현재 소속 조직 — 재직 중인 경력이 있으면 소속 줄 옆에 함께 보여 준다.
const currentJob = PROFILE.career.find((entry) => entry.endDate === null);

// CRITICAL: 플레이스홀더 URL로는 링크를 만들지 않는다 — 깨진 링크가 배포된다.
const links = PROFILE.links.filter((link) => !isPlaceholder(link.url));
const cvHref = text(PROFILE.cvUrl, lang);
const cvUrl = cvHref && !isPlaceholder(cvHref) ? cvHref : undefined;

const tagline = text(PROFILE.tagline, lang);
const bio = text(PROFILE.bio, lang);
const facts = [text(PROFILE.location, lang), PROFILE.email].filter(Boolean) as string[];

/**
 * 영문 병기는 한국어 화면에서만 의미가 있다.
 * 영어 화면에서는 `name` 자체가 이미 영문이므로 같은 값이 두 번 나오게 된다.
 */
const showNameEn = lang === 'ko' && Boolean(PROFILE.nameEn);

// 네 섹션이 모두 비면 구분선만 남은 빈 영역이 된다 — 그럴 땐 본문 블록 자체를 내지 않는다.
const hasCvBody =
  PROFILE.education.length > 0 ||
  PROFILE.career.length > 0 ||
  PROFILE.skillGroups.length > 0 ||
  PROFILE.interests.length > 0;
---

<Card class="profile-card" data-reveal-onload>
  <div class="identity">
    <div class="photo-slot">
      {
        PROFILE_PHOTO ? (
          <Image
            class="photo"
            src={PROFILE_PHOTO}
            alt={text(PROFILE.photoAlt, lang)}
            widths={[200, 280]}
            sizes="(min-width: 768px) 140px, 100px"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          /* 사진이 없을 때 — 이름 이니셜 원형 플레이스홀더 */
          <div class="photo photo-fallback" aria-hidden="true">
            {initial}
          </div>
        )
      }
    </div>

    <div class="identity-text">
      <h1 class="name">
        {name}
        {
          showNameEn && (
            <span class="name-en" lang="en">
              {PROFILE.nameEn}
            </span>
          )
        }
      </h1>

      {tagline && <p class="tagline">{tagline}</p>}

      <ul class="facts">
        {affiliation && <li>{affiliation}</li>}
        {
          currentJob && (
            <li>
              {text(currentJob.company, lang)} · {text(currentJob.role, lang)}
            </li>
          )
        }
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>

      {
        (links.length > 0 || cvUrl) && (
          <div class="actions">
            <ul class="socials">
              {links.map((link) => (
                <li>
                  <a
                    class="social-link"
                    href={link.url}
                    aria-label={text(link.label, lang)}
                    target={link.url.startsWith('mailto:') ? undefined : '_blank'}
                    rel={link.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                  >
                    <Icon
                      name={SOCIAL_ICON[link.type] ?? SOCIAL_ICON.homepage}
                      aria-hidden="true"
                    />
                  </a>
                </li>
              ))}
            </ul>
            {cvUrl && (
              <Button variant="compact-outline" href={cvUrl}>
                {t.profile.cv}
              </Button>
            )}
          </div>
        )
      }
    </div>
  </div>

  {bio && <p class="bio">{bio}</p>}

  {
    hasCvBody && (
      <div class="cv-body">
        <EducationList />
        <CareerList />
        <SkillGroups />
        <InterestList />
      </div>
    )
  }
</Card>

<style>
  .profile-card {
    /* 카드 기본 padding(20px)보다 넉넉하게 — CV 한 장의 여백감 */
    padding: var(--spacing-ext-7); /* 32px */
  }

  @media (min-width: 768px) {
    .profile-card {
      padding: var(--spacing-ext-8); /* 40px */
    }
  }

  /* ---------- 신원 블록 ---------- */
  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--spacing-ext-6); /* 24px */
  }

  @media (min-width: 640px) {
    .identity {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: var(--spacing-ext-7); /* 32px */
    }
  }

  .photo-slot {
    flex-shrink: 0;
  }

  .photo {
    width: 100px;
    height: 100px;
    border-radius: 50%; /* 프로필 사진만 예외로 원형 */
    object-fit: cover;
    /* CRITICAL: 다크 모드 이미지 필터를 프로필 사진에는 적용하지 않는다 */
    filter: none;
  }

  @media (min-width: 768px) {
    .photo {
      width: 140px;
      height: 140px;
    }
  }

  .photo-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--chip-fill);
    color: var(--fg-muted);
    font-family: var(--font-display);
    font-size: var(--text-section-mobile);
    line-height: 1;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .photo-fallback {
      font-size: var(--text-section);
    }
  }

  .identity-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-ext-2);
    min-width: 0;
  }

  @media (min-width: 640px) {
    .identity-text {
      align-items: flex-start;
    }
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--spacing-ext-3);
    font-family: var(--font-display);
    font-size: var(--text-tile-mobile); /* 20px / 26px */
    line-height: var(--text-tile-mobile--line-height);
    font-weight: 600;
    color: var(--fg);
  }

  @media (min-width: 640px) {
    .name {
      justify-content: flex-start;
    }
  }

  @media (min-width: 768px) {
    .name {
      font-size: var(--text-tile); /* 28px / 32px — CV 헤더에 40px은 과했다 */
      line-height: var(--text-tile--line-height);
      letter-spacing: var(--text-tile--letter-spacing);
    }
  }

  .name-en {
    font-family: var(--font-text);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    font-weight: 400;
    color: var(--fg-muted);
  }

  .tagline {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    font-weight: 400;
    color: var(--fg-secondary);
  }

  @media (min-width: 768px) {
    .tagline {
      font-size: var(--text-card); /* 20px / 26px */
      line-height: var(--text-card--line-height);
    }
  }

  /* 소속 · 현직 · 위치 · 이메일 — 가운뎃점으로 이어지는 한 줄 요약 */
  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--spacing-ext-2);
    list-style: none;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    letter-spacing: var(--text-small--letter-spacing);
    color: var(--fg-muted);
  }

  @media (min-width: 640px) {
    .facts {
      justify-content: flex-start;
    }
  }

  .facts > li + li::before {
    content: '·';
    margin-right: var(--spacing-ext-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-ext-3);
    margin-top: var(--spacing-ext-1);
  }

  @media (min-width: 640px) {
    .actions {
      justify-content: flex-start;
    }
  }

  .socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-ext-1);
    list-style: none;
    /* 아이콘 히트 영역이 44px이라 좌우 여백이 이미 확보된다 — 첫 아이콘만 정렬을 맞춘다 */
    margin-left: -10px;
  }

  /* 24px 아이콘 + 44x44px 히트 영역 */
  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    transition: color var(--duration-micro) var(--ease-standard);
  }

  .social-link:hover {
    color: var(--fg);
  }

  .social-link :global(svg) {
    width: 24px;
    height: 24px;
    stroke-width: 1.5;
  }

  /* ---------- 소개문 ---------- */
  .bio {
    margin-top: var(--spacing-ext-7); /* 32px */
    padding-top: var(--spacing-ext-7);
    border-top: 1px solid var(--hairline);
    max-width: 640px;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--fg);
  }

  /* ---------- CV 본문 ---------- */
  .cv-body {
    margin-top: var(--spacing-ext-7); /* 32px */
    padding-top: var(--spacing-ext-7);
    border-top: 1px solid var(--hairline);
  }

  /* .cv-body의 첫 섹션은 위 경계선이 이미 있으므로 자체 구분선을 두지 않는다.
     (.cv-section + .cv-section 규칙이 두 번째 섹션부터 적용된다 — global.css) */
</style>
