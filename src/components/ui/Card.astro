---
/**
 * 카드 프리미티브.
 *
 * CRITICAL: 그림자를 쓰지 않는다. DESIGN.md의 캡처에서 버튼과 카드 모두 shadow가 없었고
 * canonical shadow 토큰이 존재하지 않는다. 깊이는 배경 대비와 1px 헤어라인으로만 만든다.
 *
 * CRITICAL: 이 스타일을 "Apple 네이티브 카드 토큰"이라고 문서화하지 않는다.
 * HIG 문서 사이트의 크롬에서 온 값이다.
 */
interface Props {
  /** 링크 카드로 만들 URL. 지정하면 카드 전체가 하나의 링크가 된다 */
  href?: string;
  /** hover 시 배경·테두리 전환을 걸지 */
  interactive?: boolean;
  /** 내부 패딩을 뺀다 (커버 이미지를 카드 폭에 꽉 채울 때) */
  flush?: boolean;
  class?: string;
  'data-reveal'?: boolean;
  'data-reveal-onload'?: boolean;
}

const { href, interactive = false, flush = false, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'div';
const classes = [
  'card',
  (interactive || href) && 'card-interactive',
  flush && 'card-flush',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} href={href} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background: var(--surface); /* [verified] hig-reference-card */
    border-radius: var(--radius-card); /* [verified] 18px */
    /* [local extension] HIG 문서 카드에는 테두리가 캡처되지 않았으나
       #ffffff 카드를 #f5f5f7 캔버스에 얹으면 경계가 약해 헤어라인을 추가한다. */
    border: 1px solid var(--hairline);
    padding: var(--spacing-content); /* [verified] content 토큰 20px */
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }

  .card-flush {
    padding: 0;
  }

  .card-interactive {
    transition:
      background-color var(--duration-micro) var(--ease-standard),
      border-color var(--duration-micro) var(--ease-standard);
  }

  /* [local extension] transform/scale은 쓰지 않는다 */
  .card-interactive:hover {
    background: var(--surface-hover);
    border-color: var(--hairline-hover);
  }
</style>
