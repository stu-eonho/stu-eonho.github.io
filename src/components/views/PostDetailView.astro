---
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { getPublishedPosts, getSiblings, postsForLang, type Post } from '@/lib/posts';
import { estimateReadingTime } from '@/lib/reading-time';
import { i18n } from '@/config/i18n';

/**
 * `/:category/:slug`와 `/en/:category/:slug`가 공유하는 본문.
 *
 * 이웃 글은 **같은 언어 화면에 실제로 걸리는 목록** 기준으로 계산한다.
 * 전체 글 목록으로 계산하면 이전/다음이 번역본과 원문 사이를 오간다.
 */
interface Props {
  post: Post;
}

const { post } = Astro.props;
const { lang } = i18n(Astro.url);
const { Content, headings, remarkPluginFrontmatter } = await render(post);

/**
 * KaTeX CSS를 실을지.
 *
 * CRITICAL: 프론트매터의 `math`만 보면 안 된다. 본문에 수식을 쓰고 그 값을 켜지 않으면
 * KaTeX가 낸 MathML과 HTML 두 벌이 **나란히 보인다**(숨기는 주체가 그 CSS다).
 * `markdown.config.mjs`의 `remarkDetectMath`가 본문을 보고 켜 주며, 프론트매터 값은
 * 수동 강제용으로 남겨 함께 본다.
 */
const hasMath = post.data.math || remarkPluginFrontmatter?.math === true;
const siblings = getSiblings(post, postsForLang(await getPublishedPosts(), lang));
const readingTime = estimateReadingTime(post.body);
---

<PostLayout
  post={post}
  headings={headings}
  readingTime={readingTime}
  siblings={siblings}
  hasMath={hasMath}
>
  <Content />
</PostLayout>
