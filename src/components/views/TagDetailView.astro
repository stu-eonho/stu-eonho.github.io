---
import ListLayout from '@/layouts/ListLayout.astro';
import ListHeader from '@/components/post/ListHeader.astro';
import PostCard from '@/components/post/PostCard.astro';
import type { Post } from '@/lib/posts';
import { i18n } from '@/config/i18n';

/** `/tags/:tag`와 `/en/tags/:tag`가 공유하는 본문. */
interface Props {
  slug: string;
  label: string;
  posts: Post[];
}

const { slug, label, posts } = Astro.props;
const { t, href } = i18n(Astro.url);
---

<ListLayout
  path={`/tags/${slug}`}
  title={`#${label}`}
  description={t.tags.tagDescription(label, posts.length)}
>
  <ListHeader
    title={`#${label}`}
    count={t.list.postsCount(posts.length)}
    actionLabel={t.tags.viewAll}
    actionHref={href('/tags')}
  />

  <div class="card-grid" data-reveal-group>
    {posts.map((post) => <PostCard post={post} reveal />)}
  </div>
</ListLayout>
