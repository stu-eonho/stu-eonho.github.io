---
import ListLayout from '@/layouts/ListLayout.astro';
import ListHeader from '@/components/post/ListHeader.astro';
import Badge from '@/components/ui/Badge.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { getCategory } from '@/config/categories';
import { getPublishedPosts, groupByYear, postHref, postsForLang } from '@/lib/posts';
import { formatMonthDay, toISODate } from '@/lib/date';
import { i18n } from '@/config/i18n';

/** `/archive`와 `/en/archive`가 공유하는 본문. */
const { lang, t } = i18n(Astro.url);
const posts = postsForLang(await getPublishedPosts(), lang);
const groups = groupByYear(posts);
---

<ListLayout path="/archive" title={t.list.archiveTitle} description={t.list.archiveDescription}>
  <ListHeader title={t.list.archiveTitle} count={t.list.totalPosts(posts.length)} />

  {
    groups.length > 0 ? (
      groups.map((group) => (
        <section class="year-group" aria-label={t.list.yearLabel(group.year)}>
          <h2 class="year">{group.year}</h2>
          <ul class="rows" data-reveal-group>
            {group.posts.map((post) => (
              <li data-reveal>
                <a class="row" href={postHref(post, lang)}>
                  <time class="meta-text date" datetime={toISODate(post.data.date)}>
                    {formatMonthDay(post.data.date, lang)}
                  </time>
                  <Badge tone="accent">{getCategory(post.data.category).label}</Badge>
                  <span class="title">{post.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <EmptyState
        icon="lucide:archive"
        title={t.list.emptyArchiveTitle}
        hint={t.list.emptyArchiveHint}
      />
    )
  }
</ListLayout>

<style>
  .year-group {
    margin-top: var(--spacing-ext-8); /* 40px */
  }

  .year {
    font-family: var(--font-display);
    font-size: var(--text-tile);
    line-height: var(--text-tile--line-height);
    font-weight: 600;
    color: var(--fg);
    padding-bottom: var(--spacing-ext-3);
    border-bottom: 1px solid var(--hairline);
  }

  .rows {
    list-style: none;
  }

  .rows > li {
    border-bottom: 1px solid var(--hairline);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--spacing-ext-3);
    min-height: 44px;
    padding-block: var(--spacing-ext-2);
    color: inherit;
    text-decoration: none;
  }

  .date {
    flex-shrink: 0;
    width: 96px;
  }

  .title {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--fg);
    transition: color var(--duration-micro) var(--ease-standard);
  }

  .row:hover .title {
    color: var(--link);
  }

  /* 768px 미만: 날짜가 제목 위 줄로 이동해 2줄 구성이 된다 */
  @media (max-width: 767px) {
    .row {
      flex-wrap: wrap;
      align-items: flex-start;
      row-gap: var(--spacing-ext-1);
    }

    .date {
      width: auto;
    }

    .title {
      flex-basis: 100%;
    }
  }
</style>
