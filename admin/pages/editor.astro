---
/**
 * 글 편집기 — `/admin/posts/edit`
 *
 * 쿼리 `?id=`가 없으면 새 글 모드다. `?category=`로 카테고리를 선점할 수 있다.
 */
import { Icon } from 'astro-icon/components';
import AdminLayout from '../components/AdminLayout.astro';
import Button from '@/components/ui/Button.astro';
import Field from '../components/Field.astro';
import { L } from '../labels';

const TOOLS = [
  { key: 'bold', label: L.editor.toolbar.bold },
  { key: 'italic', label: L.editor.toolbar.italic },
  { key: 'link', label: L.editor.toolbar.link },
  { key: 'code', label: L.editor.toolbar.code },
  { key: 'quote', label: L.editor.toolbar.quote },
  { key: 'math', label: L.editor.toolbar.math },
  { key: 'image', label: L.editor.toolbar.image },
  { key: 'table', label: L.editor.toolbar.table },
  { key: 'h2', label: L.editor.toolbar.h2 },
  { key: 'h3', label: L.editor.toolbar.h3 },
];
---

<AdminLayout title={L.nav.editor} current="editor" savebar>
  <div class="admin-toolbar">
    <div class="admin-segment admin-tabs" role="group" aria-label="편집 / 프리뷰">
      <button type="button" class="admin-segment-item" data-tab="edit" aria-pressed="true">
        {L.editor.edit}
      </button>
      <button type="button" class="admin-segment-item" data-tab="preview" aria-pressed="false">
        {L.editor.preview}
      </button>
    </div>
    <span class="admin-path" data-editor-path></span>
    <span class="admin-toolbar-spacer"></span>
    <label class="admin-check admin-row-hidden" data-source-toggle-wrap>
      <input class="admin-check-input" type="checkbox" data-source-toggle />
      {L.editor.showSource}
    </label>
    <a class="admin-textbutton" data-view-on-site target="_blank" rel="noopener noreferrer">
      {L.posts.viewOnSite}
    </a>
  </div>

  <div class="admin-editor" data-editor data-tab="edit">
    {/* ---------- 좌: 편집 ---------- */}
    <div class="admin-editor-pane admin-editor-form">
      {/* 기본 */}
      <details class="admin-details" open>
        <summary class="admin-summary">
          <Icon name="lucide:file-text" class="admin-nav-icon" aria-hidden="true" />
          {L.editor.sectionBasic}
        </summary>
        <div class="admin-details-body">
          <Field label={L.editor.fieldTitle} for="f-title" path="title" max={120}>
            <input class="admin-input" id="f-title" type="text" data-name="title" />
          </Field>

          <Field
            label={L.editor.fieldDescription}
            for="f-desc"
            path="description"
            max={200}
            hint={L.editor.fieldDescriptionHint}
          >
            <textarea class="admin-textarea" id="f-desc" data-name="description"></textarea>
          </Field>

          <div class="admin-grid-2">
            <Field label={L.editor.fieldCategory} for="f-category" path="category">
              <select class="admin-select" id="f-category" data-name="category"></select>
            </Field>

            <Field label={L.editor.fieldSlug} for="f-slug" path="slug">
              <div style="display: flex; gap: var(--spacing-ext-2); align-items: center">
                <input class="admin-input" id="f-slug" type="text" data-name="slug" />
                <button
                  type="button"
                  class="admin-icon-button"
                  data-slug-lock
                  aria-pressed="false"
                  title={L.editor.slugLocked}
                >
                  <Icon name="lucide:lock" class="admin-nav-icon" aria-hidden="true" />
                </button>
              </div>
              <p class="admin-hint" data-slug-hint></p>
            </Field>
          </div>

          <div class="admin-grid-2">
            <Field label={L.editor.fieldDate} for="f-date" path="date">
              <input class="admin-input" id="f-date" type="date" data-name="date" />
            </Field>
            <Field label={L.editor.fieldUpdated} for="f-updated" path="updated">
              <input class="admin-input" id="f-updated" type="date" data-name="updated" />
            </Field>
          </div>

          <div class="admin-field" data-field="tags">
            <label class="admin-label" for="f-tags">{L.editor.fieldTags}</label>
            <div class="admin-chips" data-chips="tags">
              <input class="admin-chip-input" id="f-tags" type="text" />
            </div>
            <p class="admin-error" data-error>
              <Icon name="lucide:circle-alert" class="admin-error-icon" aria-hidden="true" />
              <span data-error-text></span>
            </p>
          </div>

          <div class="admin-grid-2">
            <div class="admin-readonly-row">
              <span class="admin-label">{L.editor.fieldLang}</span>
              <span class="admin-readonly-value" data-lang-display></span>
            </div>
            <div style="display: flex; gap: var(--spacing-ext-4); flex-wrap: wrap">
              <label class="admin-check">
                <input class="admin-check-input" type="checkbox" data-name="draft" />
                {L.editor.fieldDraft}
              </label>
              <label class="admin-check">
                <input class="admin-check-input" type="checkbox" data-name="math" />
                {L.editor.fieldMath}
              </label>
              <label class="admin-check">
                <input class="admin-check-input" type="checkbox" data-name="toc" />
                {L.editor.fieldToc}
              </label>
            </div>
            <p class="admin-hint">{L.editor.fieldMathHint}</p>
          </div>
        </div>
      </details>

      {/* 커버 이미지 */}
      <details class="admin-details">
        <summary class="admin-summary">
          <Icon name="lucide:image" class="admin-nav-icon" aria-hidden="true" />
          {L.editor.sectionCover}
        </summary>
        <div class="admin-details-body">
          <button type="button" class="admin-drop admin-drop-compact" data-cover-drop>
            <span>{L.assets.dropHere}</span>
          </button>

          <Field label={L.editor.fieldCover} for="f-cover" path="cover">
            <div style="display: flex; gap: var(--spacing-ext-2)">
              <select class="admin-select" id="f-cover" data-name="cover"></select>
              <button type="button" class="admin-textbutton" data-cover-clear>지우기</button>
            </div>
          </Field>

          <Field
            label={L.editor.fieldCoverAlt}
            for="f-cover-alt"
            path="coverAlt"
            hint={L.editor.coverAltRequired}
          >
            <input class="admin-input" id="f-cover-alt" type="text" data-name="coverAlt" />
          </Field>
        </div>
      </details>

      {/* 카테고리 메타 — 카테고리에 따라 내용이 통째로 바뀐다 */}
      <details class="admin-details admin-row-hidden" data-meta-section open>
        <summary class="admin-summary">
          <Icon name="lucide:info" class="admin-nav-icon" aria-hidden="true" />
          {L.editor.sectionMeta}
        </summary>
        <div class="admin-details-body">
          <p class="admin-hint admin-row-hidden" data-meta-discard>
            {L.editor.metaDiscardNotice} — {L.editor.categoryChangeWarning}
          </p>

          {/* paper */}
          <div class="admin-stack admin-row-hidden" data-meta="paper">
            <Field label="논문 제목" for="p-title" path="paper.paperTitle">
              <input class="admin-input" id="p-title" type="text" data-name="paper.paperTitle" />
            </Field>
            <div class="admin-field" data-field="paper.authors">
              <label class="admin-label" for="p-authors">저자 (Enter로 추가)</label>
              <div class="admin-chips" data-chips="authors">
                <input class="admin-chip-input" id="p-authors" type="text" />
              </div>
            </div>
            <div class="admin-grid-2">
              <Field label="학회·저널" for="p-venue" path="paper.venue">
                <input class="admin-input" id="p-venue" type="text" data-name="paper.venue" />
              </Field>
              <Field label="연도" for="p-year" path="paper.year">
                <input class="admin-input" id="p-year" type="number" data-name="paper.year" />
              </Field>
              <Field label="arXiv ID" for="p-arxiv" path="paper.arxivId">
                <input class="admin-input" id="p-arxiv" type="text" data-name="paper.arxivId" />
              </Field>
              <Field label="DOI" for="p-doi" path="paper.doi">
                <input class="admin-input" id="p-doi" type="text" data-name="paper.doi" />
              </Field>
              <Field label="PDF URL" for="p-pdf" path="paper.pdfUrl">
                <input class="admin-input" id="p-pdf" type="url" data-name="paper.pdfUrl" />
              </Field>
              <Field label="코드 URL" for="p-code" path="paper.codeUrl">
                <input class="admin-input" id="p-code" type="url" data-name="paper.codeUrl" />
              </Field>
              <Field label="읽은 날짜" for="p-read" path="paper.readDate">
                <input class="admin-input" id="p-read" type="date" data-name="paper.readDate" />
              </Field>
            </div>
          </div>

          {/* project */}
          <div class="admin-stack admin-row-hidden" data-meta="project">
            <Field label="역할" for="j-role" path="project.role">
              <input class="admin-input" id="j-role" type="text" data-name="project.role" />
            </Field>
            <div class="admin-grid-2">
              <Field label="시작 (YYYY-MM)" for="j-start" path="project.period.start">
                <input
                  class="admin-input"
                  id="j-start"
                  type="text"
                  placeholder="2026-08"
                  data-name="project.period.start"
                />
              </Field>
              <Field label="종료 (YYYY-MM)" for="j-end" path="project.period.end">
                <input class="admin-input" id="j-end" type="text" data-name="project.period.end" />
                <label class="admin-check">
                  <input class="admin-check-input" type="checkbox" data-name="project.ongoing" />
                  {L.profile.present}
                </label>
              </Field>
            </div>
            <div class="admin-field" data-field="project.stack">
              <label class="admin-label" for="j-stack">스택 (최소 1개, Enter로 추가)</label>
              <div class="admin-chips" data-chips="stack">
                <input class="admin-chip-input" id="j-stack" type="text" />
              </div>
            </div>
            <div class="admin-grid-2">
              <Field label="상태" for="j-status" path="project.status">
                <select class="admin-select" id="j-status" data-name="project.status">
                  <option value="in-progress">in-progress</option>
                  <option value="completed">completed</option>
                  <option value="archived">archived</option>
                </select>
              </Field>
              <Field label="팀 규모" for="j-team" path="project.teamSize">
                <input
                  class="admin-input"
                  id="j-team"
                  type="number"
                  min="1"
                  data-name="project.teamSize"
                />
              </Field>
              <Field label="저장소 URL" for="j-repo" path="project.repoUrl">
                <input class="admin-input" id="j-repo" type="url" data-name="project.repoUrl" />
              </Field>
              <Field label="데모 URL" for="j-demo" path="project.demoUrl">
                <input class="admin-input" id="j-demo" type="url" data-name="project.demoUrl" />
              </Field>
            </div>
          </div>
        </div>
      </details>

      {/* 본문 */}
      <div class="admin-body-editor">
        <div class="admin-mdx-tools">
          {
            TOOLS.map((tool) => (
              <button type="button" class="admin-tool" data-tool={tool.key}>
                {tool.label}
              </button>
            ))
          }
        </div>
        <label class="admin-visually-hidden" for="f-body">{L.editor.body}</label>
        <textarea class="admin-mdx" id="f-body" spellcheck="false" data-body></textarea>
        <p class="admin-hint">{L.editor.lineBreakHint}</p>
      </div>
    </div>

    {/* ---------- 우: 프리뷰 ---------- */}
    <div class="admin-editor-pane admin-editor-preview">
      <div class="admin-preview" data-preview data-pending="false">
        <span class="admin-spinner" aria-hidden="true"></span>
        <div class="admin-preview-head">
          <div data-toc-chips style="display: flex; flex-wrap: wrap; gap: var(--spacing-ext-1)">
          </div>
          <span class="admin-toolbar-spacer"></span>
          <label class="admin-check admin-preview-sync">
            <input class="admin-check-input" type="checkbox" checked data-scroll-sync />
            {L.editor.syncScroll}
          </label>
          <span class="admin-preview-note" data-reading-time></span>
        </div>
        <p class="admin-preview-note admin-row-hidden" data-preview-stale>
          {L.editor.previewStale}
        </p>

        {/* 번역 대조 — 켜면 위쪽에 반대 언어 원문이 온다 */}
        <div class="admin-row-hidden" data-source-pane>
          <p class="admin-hint">{L.editor.sourceLabel}</p>
          <pre class="admin-jsx-block" data-source-body></pre>
        </div>

        <div class="prose-body admin-preview-scroll" data-preview-html></div>
      </div>
    </div>
  </div>
</AdminLayout>

{/* 충돌 — CRITICAL: 기본 선택은 취소다 */}
<dialog class="admin-dialog" data-stale-dialog>
  <h2 class="admin-dialog-title">{L.editor.staleTitle}</h2>
  <div class="admin-dialog-body">
    <p class="admin-hint">디스크의 현재 내용과 편집 중인 내용이 다릅니다.</p>
    <pre class="admin-jsx-block" data-stale-disk></pre>
  </div>
  <div class="admin-dialog-actions">
    <Button variant="compact-outline" data-dialog-cancel>{L.editor.staleCancel}</Button>
    <Button variant="compact-outline" data-stale-load>{L.editor.staleLoadDisk}</Button>
    <Button variant="compact" data-stale-overwrite>{L.editor.staleOverwrite}</Button>
  </div>
</dialog>

{
  /*
  본문 이미지 삽입 — 실제로 올라간 파일 중에서 고른다.
  CRITICAL: 자리표시 경로를 본문에 넣지 않는다. 없는 파일을 참조하면 Vite가 모듈을
  해석하지 못해 dev 서버와 빌드가 함께 죽는다.
*/
}
{
  /*
  링크 삽입.
  CRITICAL: `](url)` 같은 자리표시를 본문에 넣지 않는다. 그대로 저장되면
  `<a href="url">`이라는 죽은 링크가 배포된다 — 실제로 그렇게 나갔다.
*/
}
<dialog class="admin-dialog" data-link-dialog>
  <h2 class="admin-dialog-title">{L.editor.insertLink}</h2>
  <div class="admin-dialog-body">
    <div class="admin-field">
      <label class="admin-label" for="link-text">{L.editor.linkText}</label>
      <input class="admin-input" id="link-text" type="text" data-link-text />
    </div>
    <div class="admin-field">
      <label class="admin-label" for="link-href">{L.editor.linkHref}</label>
      <input
        class="admin-input"
        id="link-href"
        type="text"
        data-link-href
        placeholder="https://…"
      />
      <p class="admin-hint">{L.editor.linkHrefHint}</p>
    </div>
  </div>
  <div class="admin-dialog-actions">
    <Button variant="compact-outline" data-dialog-cancel>{L.posts.cancel}</Button>
    <Button variant="compact" data-dialog-confirm>{L.editor.insert}</Button>
  </div>
</dialog>

<dialog class="admin-dialog" data-image-dialog>
  <h2 class="admin-dialog-title">{L.editor.insertImage}</h2>
  <div class="admin-dialog-body">
    <button type="button" class="admin-drop admin-drop-compact" data-image-drop>
      <span>{L.assets.dropHere}</span>
    </button>
    <p class="admin-hint">{L.editor.imagePasteHint}</p>
    <div class="admin-field">
      <label class="admin-label" for="image-pick">{L.editor.pickImage}</label>
      <select class="admin-select" id="image-pick" data-image-select></select>
      <p class="admin-hint admin-row-hidden" data-image-empty>{L.editor.noImages}</p>
    </div>
    <div class="admin-field">
      <label class="admin-label" for="image-alt">{L.editor.imageAlt}</label>
      <input class="admin-input" id="image-alt" type="text" data-image-alt />
    </div>
    <div class="admin-field">
      <label class="admin-label" for="image-width">{L.editor.imageWidth}</label>
      <input
        class="admin-input"
        id="image-width"
        type="number"
        min="1"
        max="9999"
        data-image-width
        placeholder={L.editor.imageWidthPlaceholder}
      />
      <p class="admin-hint">{L.editor.imageWidthHint}</p>
    </div>
    <div class="admin-field">
      <label class="admin-label" for="image-align">{L.editor.imageAlign}</label>
      <select class="admin-select" id="image-align" data-image-align>
        <option value="">{L.editor.alignDefault}</option>
        <option value="left">{L.editor.alignLeft}</option>
        <option value="center">{L.editor.alignCenter}</option>
        <option value="right">{L.editor.alignRight}</option>
      </select>
      <p class="admin-hint">{L.editor.imageAlignHint}</p>
    </div>
  </div>
  <div class="admin-dialog-actions">
    <Button variant="compact-outline" data-dialog-cancel>{L.posts.cancel}</Button>
    <Button variant="compact" data-dialog-confirm>{L.editor.insert}</Button>
  </div>
</dialog>

<dialog class="admin-dialog admin-table-dialog" data-table-dialog>
  <h2 class="admin-dialog-title">{L.editor.insertTable}</h2>
  <div class="admin-dialog-body">
    <div class="admin-table-config-grid">
      <div class="admin-field">
        <label class="admin-label" for="table-rows">{L.editor.tableRows}</label>
        <input
          class="admin-input"
          id="table-rows"
          type="number"
          min="1"
          max="20"
          value="5"
          data-table-rows
        />
      </div>
      <div class="admin-field">
        <label class="admin-label" for="table-columns">{L.editor.tableColumns}</label>
        <input
          class="admin-input"
          id="table-columns"
          type="number"
          min="1"
          max="8"
          value="4"
          data-table-columns
        />
      </div>
      <div class="admin-field">
        <label class="admin-label" for="table-width">{L.editor.tableWidth}</label>
        <select class="admin-select" id="table-width" data-table-width>
          <option value="full">{L.editor.tableWidthFull}</option>
          <option value="fit">{L.editor.tableWidthFit}</option>
        </select>
      </div>
      <div class="admin-field">
        <label class="admin-label" for="table-align">{L.editor.tableAlign}</label>
        <select class="admin-select" id="table-align" data-table-align>
          <option value="left">{L.editor.alignLeft}</option>
          <option value="center">{L.editor.alignCenter}</option>
          <option value="right">{L.editor.alignRight}</option>
        </select>
      </div>
      <div class="admin-field">
        <label class="admin-label" for="table-text-align">{L.editor.tableTextAlign}</label>
        <select class="admin-select" id="table-text-align" data-table-text-align>
          <option value="left">{L.editor.alignLeft}</option>
          <option value="center">{L.editor.alignCenter}</option>
          <option value="right">{L.editor.alignRight}</option>
        </select>
      </div>
      <div class="admin-field">
        <label class="admin-label" for="table-tint">{L.editor.tableTint}</label>
        <select class="admin-select" id="table-tint" data-table-tint>
          <option value="none">{L.editor.tableTintNone}</option>
          <option value="gray">{L.editor.tableTintGray}</option>
          <option value="red">{L.editor.tableTintRed}</option>
          <option value="orange">{L.editor.tableTintOrange}</option>
          <option value="yellow">{L.editor.tableTintYellow}</option>
          <option value="green">{L.editor.tableTintGreen}</option>
          <option value="blue">{L.editor.tableTintBlue}</option>
          <option value="purple">{L.editor.tableTintPurple}</option>
        </select>
      </div>
      <div class="admin-field">
        <label class="admin-label" for="table-tint-scope">{L.editor.tableTintScope}</label>
        <select class="admin-select" id="table-tint-scope" data-table-tint-scope disabled>
          <option value="header">{L.editor.tableTintHeader}</option>
          <option value="body">{L.editor.tableTintBody}</option>
          <option value="all">{L.editor.tableTintAll}</option>
        </select>
      </div>
    </div>
    <label class="admin-check">
      <input class="admin-check-input" type="checkbox" checked data-table-header />
      {L.editor.tableHeader}
    </label>
    <div class="admin-field">
      <span class="admin-label">{L.editor.tableCells}</span>
      <div class="admin-table-cell-scroll">
        <div class="admin-table-cell-grid" data-table-cell-grid></div>
      </div>
      <p class="admin-hint">{L.editor.tableHint}</p>
    </div>
  </div>
  <div class="admin-dialog-actions">
    <Button variant="compact-outline" data-dialog-cancel>{L.posts.cancel}</Button>
    <Button variant="compact" data-dialog-confirm>{L.editor.insert}</Button>
  </div>
</dialog>

{/* slug 변경 시 번역본 동반 rename 확인 */}
<dialog class="admin-dialog" data-rename-dialog>
  <h2 class="admin-dialog-title">{L.editor.renameNotice}</h2>
  <div class="admin-dialog-body">
    <ul class="admin-list" data-rename-list></ul>
  </div>
  <div class="admin-dialog-actions">
    <Button variant="compact-outline" data-dialog-cancel>{L.posts.cancel}</Button>
    <Button variant="compact" data-dialog-confirm>{L.save.save}</Button>
  </div>
</dialog>

<script>
  import { initEditor } from '../client/editor';
  // CRITICAL: 관리자 페이지는 HMR로 리로드되면 안 된다 — 편집 중인 폼이 날아간다.
  // 빈 콜백으로 자기 수용해 갱신이 전체 새로고침으로 번지지 않게 한다.
  import.meta.hot?.accept(() => {});
  void initEditor();
</script>
